<problem>

<p>Use the substitution or elimination method to find the solutions to the following systems of equations. Each system has a unique solution.</p>
 
  <part>
      <p>
        <m>2x + 3y = 0</m>, 
        <m>4x - y = 14</m>
      </p>
    <p>
      <m>x = </m><mathInput name="userX"/>, 
      <m>y = </m><mathInput name="userY"/>
    </p>
    <answer name="solAns">
      <award>
        <when>$userX = 3 and $userY = -2</when>
      </award>
    </answer>
  </part>

    <part>
      <p>
        <m>2x + 3y = 0</m>, 
        <m>4x - y = 14</m>
      </p>
    <p>
      <m>x = </m><mathInput name="userX"/>, 
      <m>y = </m><mathInput name="userY"/>
    </p>
    <answer name="solAns">
      <award>
        <when>$userX = 3 and $userY = -2</when>
      </award>
    </answer>
  </part>

</problem>


