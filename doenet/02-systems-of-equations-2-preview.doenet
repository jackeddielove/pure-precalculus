<problem>
  <p>Write the augmented matrix corresponding to each system of linear equations (using the variable order <m>x, y</m> or <m>x, y, z</m>). Use the r+/-, c+/- buttons to change the number of rows and columns.</p>

  <!-- Part 1: Standard 2x2 system -->
  <part>
    <p>
      <m>2x - 5y = 8</m><br/>
      <m>-3x + y = 4</m>
    </p>
    <answer name="ans1">
    <matrixInput name="mat1" numRows="1" numColumns="1"/>
    <award>
        <matrix>
        <row>2 -5 8</row>
        <row>-3 1 4</row>
        </matrix>
    </award>
    </answer>


  </part>

  <!-- Part 2: 3x3 system with missing variables (requires zeros) -->
  <part>
    <p>
      <m>x + 4y - 2z = 7</m><br/>
      <m>3y + 5z = -1</m><br/>
      <m>2x - z = 6</m>
    </p>
    <answer name="ans2">
    <matrixInput name="mat1" numRows="1" numColumns="1"/>
      <award>
        <matrix>
          <row>1 4 -2 7</row>
          <row>0 3 5 -1</row>
          <row>2 0 -1 6</row>
        </matrix>
      </award>
    </answer>
  </part>

  <!-- Part 3: 2x2 system not yet in standard form -->
  <part>
    <p><em>Hint: Rewrite each equation in standard form <m>ax + by = c</m> first.</em></p>
    <p>
      <m>4y = 3x - 9</m><br/>
      <m>2x + 7 = 5y</m>
    </p>
    <answer name="ans3">
    <matrixInput name="mat1" numRows="1" numColumns="1"/>
      <award>
        <matrix>
          <row>-3 4 -9</row>
          <row>2 -5 -7</row>
        </matrix>
      </award>
    </answer>
  </part>
</problem>

<problem>
  <p>Write the system of linear equations corresponding to each augmented matrix. Use <m>x, y</m> for two variables and <m>x, y, z</m> for three variables.</p>

  <!-- Part 1: 2x3 augmented matrix -> 2x2 system -->
  <part>
    <p>
      <m>\left[\begin{array}{cc|c} 4 & -1 & 9 \\ 2 & 3 & -5 \end{array}\right]</m>
    </p>
    <p>Equation 1: <mathInput name="eq1_1"/></p>
    <p>Equation 2: <mathInput name="eq1_2"/></p>
    <answer name="sysAns1">
      <award>
        <when>$eq1_1 = (4x - y = 9) and $eq1_2 = (2x + 3y = -5)</when>
      </award>
    </answer>
  </part>

  <!-- Part 2: 3x4 augmented matrix with zeros -> 3x3 system -->
  <part>
    <p>
      <m>\left[\begin{array}{ccc|c} 1 & -2 & 3 & 4 \\ 0 & 5 & -1 & 2 \\ -3 & 0 & 1 & 0 \end{array}\right]</m>
    </p>
    <p>Equation 1: <mathInput name="eq2_1"/></p>
    <p>Equation 2: <mathInput name="eq2_2"/></p>
    <p>Equation 3: <mathInput name="eq2_3"/></p>
    <answer name="sysAns2">
      <award>
        <when>$eq2_1 = (x - 2y + 3z = 4) and $eq2_2 = (5y - z = 2) and $eq2_3 = (-3x + z = 0)</when>
      </award>
    </answer>
  </part>

  <!-- Part 3: Matrix already in RREF -> reading off the solution -->
  <part>
    <p>
      <m>\left[\begin{array}{ccc|c} 1 & 0 & 0 & -2 \\ 0 & 1 & 0 & 5 \\ 0 & 0 & 1 & 3 \end{array}\right]</m>
    </p>
    <p>Equation 1: <mathInput name="eq3_1"/></p>
    <p>Equation 2: <mathInput name="eq3_2"/></p>
    <p>Equation 3: <mathInput name="eq3_3"/></p>
    <answer name="sysAns3">
      <award>
        <when>$eq3_1 = (x = -2) and $eq3_2 = (y = 5) and $eq3_3 = (z = 3)</when>
      </award>
    </answer>
  </part>
</problem>
