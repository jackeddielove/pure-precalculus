\relax 
\providecommand\zref@newlabel[2]{}
\newlabel{def:linear-eqn}{{1}{1}{}{definition.1}{}}
\newlabel{eqn:linear-system-1}{{1}{2}{}{equation.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The graphs of \(-x+y=-1\) and \(\frac  {1}{2}x+y=2\) intersect at the point \((2, 1)\), the solution to the corresponding linear system.}}{2}{}\protected@file@percent }
\newlabel{fig:linear-system-1}{{1}{2}{}{figure.1}{}}
\newlabel{eqn:linear-system-2}{{2}{2}{}{equation.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Two planes and their line of intersection. Each plane represents the solutions to a linear equation in three variables; the line where they intersect represents the solutions to the corresponding system.}}{3}{}\protected@file@percent }
\newlabel{fig:linear-system-2}{{2}{3}{}{figure.2}{}}
\newlabel{eqn:linear-system-2}{{3}{3}{}{equation.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The graphs of \(-x+y=-1\) and \(-x+y=2\) do not intersect; the corresponding linear system has no solutions.}}{4}{}\protected@file@percent }
\newlabel{fig:linear-system-2}{{3}{4}{}{figure.3}{}}
\gdef \@abspage@last{4}
